# Discord Bot Token (https://discord.com/developers/applications 에서 발급)
DISCORD_TOKEN=your_bot_token_here

# 명령을 허용할 Discord 유저 ID (쉼표로 구분)
# 비워두면 모든 유저 허용
ALLOWED_USER_IDS=123456789,987654321

# 명령을 허용할 채널 ID (쉼표로 구분)
# 비워두면 모든 채널 허용 (DM 포함)
ALLOWED_CHANNEL_IDS=

# Claude CLI 경로
CLAUDE_PATH=/home/wasd222/.local/bin/claude

# 명령 prefix (기본값: !c)
COMMAND_PREFIX=!c

# 응답 타임아웃 (밀리초, 기본값: 30000)
RESPONSE_TIMEOUT=30000
