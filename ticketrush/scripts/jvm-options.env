# TicketRush JVM 옵션 환경 파일
# ADR-004: JVM GC 전략 — G1GC → ZGC 전환 (ZGC STW pause < 1ms)
# 사용법: source scripts/jvm-options.env 후 해당 서비스 JAVA_OPTS로 jar 실행

# ── WebFlux 서비스 (seat-api, queue-api, notification-api) ────────────────
# WebFlux 비동기 I/O 모델 — 스레드가 적고 GC 민감도 높음
# 힙 설정: Xms256m / Xmx768m (이벤트 루프 기반으로 큰 힙 불필요)
SEAT_API_JAVA_OPTS=-XX:+UseZGC -XX:ZCollectionInterval=5 -XX:ZUncommitDelay=300 -XX:+ZProactive -Xms256m -Xmx768m
QUEUE_API_JAVA_OPTS=-XX:+UseZGC -XX:ZCollectionInterval=5 -XX:ZUncommitDelay=300 -XX:+ZProactive -Xms256m -Xmx768m
NOTIFICATION_API_JAVA_OPTS=-XX:+UseZGC -XX:ZCollectionInterval=5 -XX:ZUncommitDelay=300 -XX:+ZProactive -Xms256m -Xmx768m

# ── MVC 서비스 (order-api, payment-api) ──────────────────────────────────
# Spring MVC 블로킹 모델 — JPA + 스레드풀로 더 큰 힙 필요
# 힙 설정: Xms512m / Xmx1536m (HikariCP + JPA 1차 캐시 고려)
ORDER_API_JAVA_OPTS=-XX:+UseZGC -XX:ZCollectionInterval=5 -XX:ZUncommitDelay=300 -XX:+ZProactive -Xms512m -Xmx1536m
PAYMENT_API_JAVA_OPTS=-XX:+UseZGC -XX:ZCollectionInterval=5 -XX:ZUncommitDelay=300 -XX:+ZProactive -Xms512m -Xmx1536m
