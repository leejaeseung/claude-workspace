{
  "expo": {
    "name": "recipe-voice-app",
    "slug": "recipe-voice-app",
    "scheme": "recipevoice",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "음성 인식을 위해 마이크 접근을 허용해주세요.",
        "NSSpeechRecognitionUsageDescription": "말씀하신 내용을 텍스트로 변환하기 위해 음성 인식 권한을 허용해주세요."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.wasd12397steam.recipevoiceapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "음성으로 레시피를 검색하거나 요리 중 음성 명령을 쓰기 위해 마이크 접근을 허용해주세요."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "음성 인식을 위해 마이크 접근을 허용해주세요.",
          "speechRecognitionPermission": "말씀하신 내용을 텍스트로 변환하기 위해 음성 인식 권한을 허용해주세요.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c9331e8d-8170-4bbd-9c0c-a773dedec312"
      }
    }
  }
}
