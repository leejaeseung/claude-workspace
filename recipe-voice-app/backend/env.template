PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/recipe_voice_app
JWT_SECRET=change-me-to-a-long-random-string

# 핸즈프리 요리 모드에서 로컬 인텐트 매처가 실패한 발화의 온라인 인텐트 추정(/api/voice/intent)에 사용.
# 레시피 등록은 음성이 아니라 직접 입력만 지원하므로 STT(전사) 관련 설정은 없다.
OPENAI_API_KEY=sk-...
OPENAI_INTENT_MODEL=gpt-4o-mini

# 로그인 화면 없이도 /api/voice/intent를 테스트할 수 있게 허용. 실제 배포 전에는 false로.
ALLOW_ANON_VOICE=true
